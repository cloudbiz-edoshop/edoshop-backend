# Stripe (optional — card payments at checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=xaf
EXCHANGE_XAF_PER_USD=600
EXCHANGE_XAF_PER_EUR=655
STOREFRONT_URL=http://localhost:3000

# Edoshop Team authentication via Nextcloud
NEXTCLOUD_URL=https://mydrive.edoshop.online
NEXTCLOUD_AUTH_ENABLED=true
# Local dev: http://localhost:5173 | Production: https://admin.edoshop.online
ADMIN_PANEL_URL=http://localhost:5173
# Create an OAuth client in Nextcloud → Security → OAuth clients:
# NEXTCLOUD_OAUTH_CLIENT_ID=
# NEXTCLOUD_OAUTH_CLIENT_SECRET=
# Local:  http://localhost:9999/v1/auth/nextcloud/callback
# Prod:   https://api.edoshop.online/v1/auth/nextcloud/callback
# NEXTCLOUD_OAUTH_REDIRECT_URI=http://localhost:9999/v1/auth/nextcloud/callback

# MinIO / S3-compatible object storage (required for image uploads)
# Local dev: run `npm run minio:start` in backend, then use:
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edoshop
# Production (Dokploy): deploy a MinIO service and point the backend at its internal hostname, e.g.:
# MINIO_ENDPOINT=edoshop-minio
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=<your-minio-root-user>
# MINIO_SECRET_KEY=<your-minio-root-password>
# MINIO_BUCKET_NAME=edoshop

CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_ENVIRONMENT=prod
CAMPAY_BASE_URL=
CAMPAY_CURRENCY=xaf
# Sandbox test phone (CamPay demo): +237672453430

# WhatsApp Cloud API (required for OTP / password reset via WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v21.0
